Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 10
  Displays:
    - Class: rviz_default_plugins/Map
      Name: "[Map A] Obstacles + walls (obstacle_grid)"
      Enabled: true
      Topic:
        Value: /navigation/obstacle_grid
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.8
    - Class: rviz_default_plugins/Map
      Name: "[Map B] Static map (/map) - do NOT enable with other Map"
      Enabled: false
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.6
    - Class: rviz_default_plugins/Map
      Name: "[Map C] MPPI costmap - do NOT enable with other Map"
      Enabled: false
      Topic:
        Value: /native_mppi/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.7
    - Class: rviz_default_plugins/TF
      Name: Robot frames
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
    - Class: rviz_default_plugins/Path
      Name: Global path
      Enabled: true
      Color: 0; 170; 255
      Line Style: Lines
      Topic:
        Value: /navigation/global_path
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Local path (MPPI)
      Enabled: true
      Color: 0; 255; 110
      Line Style: Lines
      Topic:
        Value: /navigation/local_path
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Nav2 reference path
      Enabled: false
      Color: 170; 120; 255
      Line Style: Lines
      Topic:
        Value: /navigation/nav2_reference
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Opponent (tracked)
      Enabled: true
      Topic:
        Value: /navigation/opponent
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 40; 40
        Alpha: 1
        Head Length: 0.3
        Head Radius: 0.15
        Shaft Length: 0.4
        Shaft Radius: 0.07
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose
      Enabled: false
      Topic:
        Value: /amcl_pose
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: Localization scan (light)
      Enabled: false
      Topic:
        Value: /localization/scan
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: "[heavy] Robot scan (map frame)"
      Enabled: false
      Topic:
        Value: /navigation/scan
        Reliability Policy: Best Effort
      Size (m): 0.035
      Style: Points
      Color Transformer: FlatColor
      Color: 100; 210; 255
    - Class: rviz_default_plugins/PointCloud2
      Name: "[heavy] Obstacle scan (planner input)"
      Enabled: false
      Topic:
        Value: /navigation/obstacle_scan
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 140; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: "[heavy] Ignored small boxes"
      Enabled: false
      Topic:
        Value: /navigation/ignored_obstacles
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 0; 255
    - Class: rviz_default_plugins/PointCloud2
      Name: "[heavy] Raw filtered lidar"
      Enabled: false
      Topic:
        Value: /sensing/lidar/points_filtered
        Reliability Policy: Best Effort
      Size (m): 0.025
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/RobotModel
      Name: "[heavy] Robot model"
      Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 120
      X: 1.5
      Y: 2.0
Window Geometry:
  Height: 800
  Width: 1100
