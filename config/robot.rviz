Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 10
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Obstacles + walls (obstacle_grid)
      Enabled: true
      Topic:
        Value: /navigation/obstacle_grid
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.8
    - Class: rviz_default_plugins/TF
      Name: Robot frames
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
    - Class: rviz_default_plugins/Path
      Name: Global path
      Enabled: true
      Color: 0; 170; 255
      Line Style: Lines
      Topic:
        Value: /navigation/global_path
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Local path
      Enabled: true
      Color: 0; 255; 110
      Line Style: Lines
      Topic:
        Value: /navigation/local_path
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Opponent (tracked)
      Enabled: true
      Topic:
        Value: /navigation/opponent
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 40; 40
        Alpha: 1
        Head Length: 0.3
        Head Radius: 0.15
        Shaft Length: 0.4
        Shaft Radius: 0.07
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 120
      X: 1.5
      Y: 2.0
Window Geometry:
  Height: 800
  Width: 1100
