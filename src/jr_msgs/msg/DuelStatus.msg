# Состояние соревнования между атакующим и защитником.
#
# Соревнование заканчивается в двух случаях: атакующий заехал в синюю зону
# (победа атакующего) либо защитник подошёл к нему ближе стоп-дистанции
# (победа защитника). В обоих случаях роботы сразу останавливаются.

std_msgs/Header header

# Исход: IN_PROGRESS, пока никто не выполнил условие.
string IN_PROGRESS=process
string ATTACKER_WON=attacker won
string DEFENDER_WON=defender won
string result

# Расстояние от атакующего до центра синей зоны по прямой, метров.
float64 goal_distance_euclidean

# То же, но вдоль текущего пути атакующего: сумма длин его отрезков.
# Отличается от прямой там, где путь обходит стены или соперника.
# NaN, если путь ещё не опубликован.
float64 goal_distance_path

# Зазор между краями роботов, метров: расстояние между центрами за вычетом
# двух футпринтов. Может быть отрицательным, если роботы перекрылись.
float64 robots_distance

# Атакующий пересёк синюю зону футпринтом.
bool attacker_in_zone

# Зазор до атакующего не больше стоп-дистанции.
bool defender_caught
