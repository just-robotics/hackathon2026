<?xml version="1.0"?>
<package format="3">
  <name>jr_launch</name>
  <version>0.1.0</version>
  <description>Launch files for the hackathon2026 stack.</description>

  <maintainer email="dev@just-robotics.ru">Just Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>foxglove_bridge</exec_depend>
  <!-- swarm_controller приходит из подмодуля mpc_motion_control и может быть
       не подключен, поэтому в зависимостях его нет: jr_control и jr_planning
       в этом случае просто не найдут пакет при запуске, а сборка jr_launch
       и образа остается рабочей -->


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
