<?xml version="1.0" encoding="UTF-8"?>
<!-- Детектор соперника с локализацией FAST-LIO2 вместо AMCL.

     /livox/lidar (PointCloud2) идёт в два места:
       real_lidar_filter -> /sensing/lidar/points_filtered -> детектор;
       livox_custom.py -> /livox/lidar_custom (CustomMsg) -> FAST-LIO2 вместе с /livox/imu.
     fastlio_bridge.py переводит позу FAST-LIO2 в позу base_footprint во фрейме
     map (/localization/fastlio/odometry, её берёт детектор) и публикует
     TF map -> odom.

     Стартовая поза робота на карте — x, y, yaw: FAST-LIO2 карту не знает
     и считает от точки старта. Точно её даёт initial_pose.py по первым
     сканам бэга (ros2 run jr_perception initial_pose.py).

     На бэгах (sim_time, по умолчанию): бэг на паузе с ключами clock и
     start-paused, потом этот launch, потом пробел в терминале бэга. В бэге
     нужны /livox/lidar, /livox/imu, /tf, /tf_static и /map; если /map нет
     (ручные записи), задайте map. Повтор бэга по кругу не годится: FAST-LIO2
     продолжит с конца прошлого прохода. В autonomous-записях в /tf уже есть
     map -> odom от AMCL робота, поэтому там publish_tf:=false.

     Нужен собранный пакет fast_lio, а для map — пакеты nav2 map_server и
     lifecycle_manager. -->
<launch>
  <arg name="config" description="каталог с lidar_filter.yaml (и maps/): config/ репозитория или папка сессии"/>
  <arg name="x" default="0.5" description="старт base_footprint на карте, м"/>
  <arg name="y" default="0.5"/>
  <arg name="yaw" default="0.0" description="рад"/>
  <arg name="map" default="" description="карта Nav2 .yaml, если /map нет в бэге"/>
  <arg name="publish_tf" default="true" description="TF map -> odom от моста"/>
  <arg name="sim_time" default="true" description="время бэга (false -- живой робот)"/>
  <arg name="rviz" default="true"/>

  <node pkg="hsl_lidar_filter" exec="real_lidar_filter" name="real_lidar_filter" output="screen">
    <param from="$(var config)/lidar_filter.yaml"/>
    <param name="lidar_topic" value="/livox/lidar"/>
    <param name="use_sim_time" value="$(var sim_time)"/>
  </node>

  <node pkg="jr_perception" exec="livox_custom.py" name="livox_custom" output="screen">
    <param name="use_sim_time" value="$(var sim_time)"/>
  </node>

  <node pkg="fast_lio" exec="fastlio_mapping" name="laser_mapping" output="screen">
    <param from="$(find-pkg-share jr_launch)/config/perception/fastlio.param.yaml"/>
    <param name="use_sim_time" value="$(var sim_time)"/>
  </node>

  <!-- camera_init FAST-LIO2 — перевёрнутый лидар на старте; fl_up — тот же
       фрейм с z вверх, для config/perception/fastlio_view.rviz -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="fl_up_tf"
        args="--qx -0.7071068 --qy 0.7071068 --qz 0 --qw 0 --frame-id fl_up --child-frame-id camera_init"/>

  <node pkg="jr_perception" exec="fastlio_bridge.py" name="fastlio_bridge" output="screen">
    <param name="x" value="$(var x)"/>
    <param name="y" value="$(var y)"/>
    <param name="yaw" value="$(var yaw)"/>
    <param name="publish_tf" value="$(var publish_tf)"/>
    <param name="use_sim_time" value="$(var sim_time)"/>
  </node>

  <group if="$(eval '\'$(var map)\' != \'\'')">
    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
      <param name="yaml_filename" value="$(var map)"/>
      <param name="use_sim_time" value="$(var sim_time)"/>
    </node>
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="map_lifecycle_manager" output="screen">
      <param name="autostart" value="true"/>
      <param name="node_names" value="[map_server]"/>
      <param name="use_sim_time" value="$(var sim_time)"/>
    </node>
  </group>

  <!-- облако: фильтры и сегментация земли, детектор берёт облако препятствий -->
  <include file="$(find-pkg-share jr_launch)/launch/components/jr_ground_segmentation.launch.xml">
    <arg name="cloud_topic" value="/sensing/lidar/points_filtered"/>
    <arg name="sim_time" value="$(var sim_time)"/>
  </include>

  <node pkg="jr_perception" exec="robot_detector.py" name="robot_detector" output="screen">
    <param from="$(find-pkg-share jr_launch)/config/perception/detector_fastlio.param.yaml"/>
  </node>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="rviz2"
        args="-d $(find-pkg-share jr_launch)/config/perception/detector_map.rviz">
    <param name="use_sim_time" value="$(var sim_time)"/>
  </node>
</launch>
