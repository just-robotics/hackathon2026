<?xml version="1.0" encoding="UTF-8"?>
<!-- Карта занятости по описанию мира Gazebo.

     Стены лабиринта заданы в SDF box-коллизиями, поэтому карта считается
     аналитически из того же .world, который грузит симулятор, и появляется
     сразу при старте, без объезда лабиринта.

     Публикуется nav_msgs/OccupancyGrid в /map с transient_local QoS. -->
<launch>
  <arg name="simulation" default="true" description="запуск в симуляторе"/>

  <arg name="map" default="polygon_rosbag" description="имя мира из sim_kobuki/worlds"/>
  <arg name="world"
       default="$(find-pkg-share sim_kobuki)/worlds/$(var map).world"/>
  <arg name="map_origin_x" default="-0.468"/>
  <arg name="map_origin_y" default="-0.582"/>
  <arg name="resolution" default="0.05" description="метров на ячейку"/>
  <arg name="padding" default="1.0" description="свободные поля вокруг, м"/>
  <arg name="z_slice" default="0.25"
       description="высота среза: на ней берутся коллизии стен"/>
  <arg name="frame_id" default="map"/>
  <arg name="topic" default="/map"/>

  <!-- Gazebo /odom is world-based; map zero is the lower-left wall corner. -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="map_to_odom_tf"
        args="--x $(eval '-float($(var map_origin_x))') --y $(eval '-float($(var map_origin_y))') --z 0.0
              --roll 0.0 --pitch 0.0 --yaw 0.0
              --frame-id $(var frame_id)
              --child-frame-id odom"/>

  <node pkg="jr_map" exec="sdf_map_server.py" name="sdf_map_server"
        output="screen">
    <param name="world" value="$(var world)"/>
    <param name="spawn_x" value="$(var map_origin_x)"/>
    <param name="spawn_y" value="$(var map_origin_y)"/>
    <param name="resolution" value="$(var resolution)"/>
    <param name="padding" value="$(var padding)"/>
    <param name="z_slice" value="$(var z_slice)"/>
    <param name="frame_id" value="$(var frame_id)"/>
    <param name="topic" value="$(var topic)"/>
    <param name="use_sim_time" value="$(var simulation)"/>
  </node>
</launch>
