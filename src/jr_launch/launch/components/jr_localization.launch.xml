<?xml version="1.0" encoding="UTF-8"?>
<!-- Локализация: LIO-SAM по облаку Livox и IMU.

     Пакет lio_sam приходит из подмодуля (ветка main репозитория
     mpc_motion_control), он подключается командой `helm submodules`.

     Результат публикуется в отдельную ветку TF
     lio_sam_map -> lio_sam_odom -> lio_sam_base и не пересекается с деревом
     симулятора (odom -> base_footprint -> base_link), поэтому обе оценки позы
     сосуществуют и их можно сравнивать. -->
<launch>
  <arg name="simulation" default="true" description="запуск в симуляторе"/>

  <arg name="params_file"
       default="$(find-pkg-share jr_launch)/config/localization/lio_sam.param.yaml"/>
  <arg name="anchor_frame" default="odom" description="фрейм симулятора, к которому крепится дерево локализации"/>
  <arg name="map_frame" default="lio_sam_map"/>

  <!-- Связываем дерево симулятора с деревом локализации.

       Крепимся именно к корню lio_sam_map: цепочку
       lio_sam_map -> lio_sam_odom -> lio_sam_base публикует сам LIO-SAM
       (динамически), и если попытаться задать lio_sam_base статически, у него
       окажется два родителя: динамический трансформ победит, а деревья
       останутся несвязанными.

       Трансформ нулевой: LIO-SAM начинает отсчет с позы робота при старте,
       то есть его начало координат совпадает с odom симулятора. -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="lio_sam_map_anchor_tf"
        args="--x 0.0 --y 0.0 --z 0.0
              --roll 0.0 --pitch 0.0 --yaw 0.0
              --frame-id $(var anchor_frame)
              --child-frame-id $(var map_frame)"/>

  <include file="$(find-pkg-share lio_sam)/launch/run.launch.py">
    <arg name="params_file" value="$(var params_file)"/>
    <arg name="rviz" value="false"/>
  </include>
</launch>
