<?xml version="1.0" encoding="UTF-8"?>
<!-- Управление: /planning/trajectory + /odom -> /cmd_vel.

     Ноды приходят из подмодуля mpc_motion_control (пакет swarm_controller),
     он подключается командой `helm submodules`.

     Продольный контур стартует с start=false и не двигает робота, пока
     параметр не выставят: `helm start`. -->
<launch>
  <arg name="simulation" default="true" description="запуск в симуляторе"/>

  <arg name="lateral" default="true" description="удержание в полосе поверх продольного контура"/>
  <arg name="longitudinal" default="cc" description="cc -- свой профиль скорости, acc -- зазор за лидером"/>
  <arg name="trajectory_topic" default="/planning/trajectory"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="peer_id" default="leader" description="префикс топиков лидера для acc"/>

  <include file="$(find-pkg-share swarm_controller)/launch/sim_control.launch.py">
    <arg name="lateral" value="$(var lateral)"/>
    <arg name="longitudinal" value="$(var longitudinal)"/>
    <arg name="trajectory_topic" value="$(var trajectory_topic)"/>
    <arg name="odom_topic" value="$(var odom_topic)"/>
    <arg name="cmd_vel_topic" value="$(var cmd_vel_topic)"/>
    <arg name="peer_id" value="$(var peer_id)"/>
  </include>
</launch>
