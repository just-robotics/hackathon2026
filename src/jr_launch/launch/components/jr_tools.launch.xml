<?xml version="1.0" encoding="UTF-8"?>
<!-- Инструменты отладки: мост Foxglove. -->
<launch>
  <arg name="simulation" default="true" description="запуск в симуляторе"/>
  <arg name="use_sim_time" default="$(var simulation)"/>

  <arg name="port" default="8765"/>
  <arg name="address" default="0.0.0.0"/>

  <include file="$(find-pkg-share jr_launch)/launch/components/other/foxglove_bridge.launch.xml">
    <arg name="port" value="$(var port)"/>
    <arg name="address" value="$(var address)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
</launch>
