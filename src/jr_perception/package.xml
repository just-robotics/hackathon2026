<?xml version="1.0"?>
<package format="3">
  <name>jr_perception</name>
  <version>0.1.0</version>
  <description>Opponent Kobuki detection and tracking from the lidar point cloud.</description>

  <maintainer email="dev@just-robotics.ru">Just Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <build_depend>visualization_msgs</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>jr_map</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- livox_custom.py: CustomMsg для FAST-LIO2 -->
  <exec_depend>livox_ros_driver2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
