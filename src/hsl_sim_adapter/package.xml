<?xml version="1.0"?>
<package format="3">
  <name>hsl_sim_adapter</name>
  <version>0.1.0</version>
  <description>Gazebo-only observation and scenario adapters for navigation tests.</description>
  <maintainer email="dev@just-robotics.ru">Just Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>hsl_interfaces</exec_depend>
  <exec_depend>hsl_decision</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <export><build_type>ament_python</build_type></export>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>jr_perception</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
</package>
