Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
    Color: 95; 95; 95
  - Class: rviz_default_plugins/Map
    Name: Maze map
    Enabled: true
    Topic:
      Value: /map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color Scheme: map
    Alpha: 0.55
  - Class: rviz_default_plugins/Map
    Name: First robot observed obstacle map
    Enabled: true
    Topic:
      Value: /navigation/obstacle_grid
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color Scheme: costmap
    Alpha: 0.65
  - Class: rviz_default_plugins/RobotModel
    Name: First robot
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/RobotModel
    Name: Second robot
    TF Prefix: opponent
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /opponent/robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/TF
    Name: Robot frames
    Enabled: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
  - Class: rviz_default_plugins/Path
    Name: First robot global path
    Enabled: true
    Color: 0; 170; 255
    Line Style: Lines
    Line Width: 0.035
    Topic:
      Value: /navigation/global_path
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: First robot local path
    Enabled: true
    Color: 0; 255; 110
    Line Style: Lines
    Line Width: 0.06
    Topic:
      Value: /navigation/local_path
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Second robot global path
    Enabled: true
    Color: 255; 170; 0
    Line Style: Lines
    Line Width: 0.035
    Topic:
      Value: /opponent/navigation/global_path
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Second robot local path
    Enabled: true
    Color: 255; 50; 60
    Line Style: Lines
    Line Width: 0.06
    Topic:
      Value: /opponent/navigation/local_path
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PointCloud2
    Name: First robot scan
    Enabled: true
    Topic:
      Value: /navigation/scan
      Reliability Policy: Best Effort
    Size (m): 0.035
    Style: Points
    Color Transformer: FlatColor
    Flat Color: 100; 210; 255
  - Class: rviz_default_plugins/PointCloud2
    Name: Second robot scan
    Enabled: false
    Topic:
      Value: /opponent/navigation/scan
      Reliability Policy: Best Effort
    Size (m): 0.035
    Style: Points
    Color Transformer: FlatColor
    Flat Color: 255; 190; 100
  - Class: rviz_default_plugins/MarkerArray
    Name: Detector objects
    Enabled: true
    Topic:
      Value: /opponent/markers
      Reliability Policy: Reliable
    Queue Size: 10
  - Class: rviz_default_plugins/MarkerArray
    Name: opponent/Detector objects
    Enabled: true
    Topic:
      Value: /opponent/opponent/markers
      Reliability Policy: Reliable
    Queue Size: 10
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 0.34
        Y: 2.1
        Z: 0
      Near Clip Distance: 0.01
      Pitch: 1.45
      Target Frame: <Fixed Frame>
      Yaw: 0
Window Geometry:
  Height: 850
  Width: 1200
