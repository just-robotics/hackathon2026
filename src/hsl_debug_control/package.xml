<?xml version="1.0"?>
<package format="3">
  <name>hsl_debug_control</name>
  <version>0.1.0</version>
  <description>Replaceable safety-gated path follower for Gazebo tests.</description>
  <maintainer email="dev@just-robotics.ru">Just Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>hsl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
