Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
    Color: 95; 95; 95
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Topic:
      Value: /map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color Scheme: map
    Alpha: 0.55
  - Class: rviz_default_plugins/Map
    Name: Obstacle costmap
    Enabled: false
    Topic:
      Value: /navigation/obstacle_grid
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color Scheme: costmap
    Alpha: 0.65
  - Class: rviz_default_plugins/RobotModel
    Name: Robot
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/TF
    Name: Robot frames
    Enabled: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
  - Class: rviz_default_plugins/Path
    Name: Robot global path
    Enabled: true
    Color: 0; 170; 255
    Line Style: Lines
    Line Width: 0.035
    Topic:
      Value: /navigation/global_path
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Robot local path
    Enabled: true
    Color: 0; 255; 110
    Line Style: Lines
    Line Width: 0.06
    Topic:
      Value: /navigation/local_path
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Nav2 reference path
    Enabled: false
    Color: 170; 120; 255
    Line Style: Lines
    Line Width: 0.03
    Topic:
      Value: /navigation/nav2_reference
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PointCloud2
    Name: Robot scan
    Enabled: true
    Topic:
      Value: /navigation/scan
      Reliability Policy: Best Effort
    Size (m): 0.035
    Style: Points
    Color Transformer: FlatColor
    Flat Color: 100; 210; 255
  - Class: rviz_default_plugins/PointCloud2
    Name: Obstacle scan (planner input)
    Enabled: true
    Topic:
      Value: /navigation/obstacle_scan
      Reliability Policy: Best Effort
    Size (m): 0.05
    Style: Points
    Color Transformer: FlatColor
    Flat Color: 255; 140; 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw filtered lidar
    Enabled: false
    Topic:
      Value: /sensing/lidar/points_filtered
      Reliability Policy: Best Effort
    Size (m): 0.025
    Style: Points
    Color Transformer: FlatColor
    Flat Color: 255; 255; 0
  - Class: rviz_default_plugins/Odometry
    Name: Opponent (tracked)
    Enabled: true
    Topic:
      Value: /navigation/opponent
      Reliability Policy: Reliable
    Position Tolerance: 0.05
    Angle Tolerance: 0.1
    Keep: 1
    Shape:
      Value: Arrow
      Color: 255; 40; 40
      Alpha: 1
      Head Length: 0.2
      Head Radius: 0.1
      Shaft Length: 0.3
      Shaft Radius: 0.05
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 0.34
        Y: 2.1
        Z: 0
      Near Clip Distance: 0.01
      Pitch: 1.45
      Target Frame: <Fixed Frame>
      Yaw: 0
Window Geometry:
  Height: 850
  Width: 1200
