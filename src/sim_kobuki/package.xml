<?xml version="1.0"?>
<package format="3">
  <name>sim_kobuki</name>
  <version>0.1.0</version>
  <description>Kobuki simulation package for Gazebo Classic and ROS 2 Humble.</description>

  <maintainer email="dev@just-robotics.ru">Just Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <exec_depend>hsl_sim_adapter</exec_depend>
</package>
