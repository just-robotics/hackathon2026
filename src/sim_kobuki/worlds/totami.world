      </link>
      <link name="Pad_Blue">
        <visual name="Pad_Blue_Visual">
          <pose>0 0 0 0 -0 0</pose>
          <geometry>
            <box>
              <size>1.0 2.0 0.001</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
