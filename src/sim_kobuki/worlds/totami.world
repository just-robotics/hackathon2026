        <kinematic>0</kinematic>
      </link>
      <link name="Wall_East">
        <collision name="Wall_East_Collision">
          <geometry>
            <box>
              <size>8.0 0.045 0.6</size>
            </box>
          </geometry>
          <pose>0 0 0.3 0 -0 0</pose>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode />
            </contact>
            <bounce />
            <friction>
              <torsional>
                <ode />
              </torsional>
              <ode />
            </friction>
          </surface>
        </collision>
        <visual name="Wall_East_Visual">
          <pose>0 0 0.3 0 -0 0</pose>
          <geometry>
            <box>
              <size>8.0 0.045 0.6</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
