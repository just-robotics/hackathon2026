#
# Основной образ автопилота
#
IMAGE="jr_image:latest"

#
# Выбор карты -- мира Gazebo из sim_kobuki/worlds/ (без расширения .world)
#
MAP=maze

#
# Карта для режима двух роботов (helm up duel). Отдельная от MAP: точки
# спавна защитника и атакующего заданы под площадки totami.
#
DUEL_MAP=totami

#
# Размер ячейки карты занятости (/map), метров
#
MAP_RESOLUTION=0.05

#
# Лидар на роботе. Выключен: в Gazebo Classic лучи считаются на CPU и
# заметно снижают RTF. Карта /map строится из описания мира и лидара не
# требует. Включить: LIDAR=true
#
LIDAR=false

#
# Параметры bash-сессии
#
CMD="/bin/bash -ic"

#
# Использование разделения вычислительных ресурсов по сервисам
#
USE_RESOURCES_SPLITTING=false  # true | false

#
# Использовать симулятор
#
USE_SIMULATION=true  # true | false

#
# Включение/выключение пайплайна восприятия
# При выключении используется empty_perception
#
USE_PERCEPTION=true  # true | false

#
# Headless-режим Gazebo. По умолчанию окно симулятора открывается автоматически;
# установите true для запуска без графики (например, на сервере без дисплея).
#
GAZEBO_HEADLESS=false  # true | false

#
# Точка спавна робота в мире Gazebo (maze.world -- старт лабиринта)
#
SPAWN_X=-0.34
SPAWN_Y=-0.18
SPAWN_Z=0.23

#
# Параметры MPC-контроллера из подмодуля mpc_motion_control.
# Применяются к сервисам planning и control.
#
MPC_TRAJECTORY=lanelet                      # line | circle | lanelet
MPC_TRAJECTORY_FILE=my_trajectory5.yaml     # waypoints для lanelet
MPC_LATERAL=true                            # удержание в полосе
MPC_LONGITUDINAL=cc                         # cc | acc

#
# Дистанция поимки: защитник ближе неё к атакующему означает его победу
#
CATCH_DISTANCE=0.1

#
# Режим дуэли в лабиринте: helm up duel с DUEL_MAP=maze_duel
# Синяя зона вверху справа, красная внизу слева, ход по диагонали.
# Для totami зона в (3.5, 0): BLUE_ZONE_X=3.5 BLUE_ZONE_Y=0.0
#
# MAZE_DUEL: DUEL_MAP=maze_duel BLUE_ZONE_X=2.4 BLUE_ZONE_Y=4.4
