#
# Основной образ автопилота
#
IMAGE="jr_image:latest"

#
# Выбор карты (mipt по умолчанию)
#
MAP=mipt

#
# Параметры bash-сессии
#
CMD="/bin/bash -ic"

#
# Использование разделения вычислительных ресурсов по сервисам
#
USE_RESOURCES_SPLITTING=false  # true | false

#
# Использовать симулятор
#
USE_SIMULATION=true  # true | false

#
# Включение/выключение пайплайна восприятия
# При выключении используется empty_perception
#
USE_PERCEPTION=true  # true | false

#
# Адрес симулятора для браузерного клиента (нативный сам спрашивает при
# подключении). Менять только если браузер открыт на другой машине --
# тогда указать адрес хоста и пересобрать: helm build web-viewer
#
WEB_VIEWER_HOST=127.0.0.1

#
# Поднимать ли веб-просмотр вместе с симулятором.
# true  -- web-viewer идёт в комплекте с helm up isaac
# false -- только по явному helm up web-viewer
# Нативный клиент доступен в обоих случаях, см. README.
#
USE_WEB=false  # true | false

#
# Порт веб-интерфейса симулятора
#
WEB_VIEWER_PORT=8210
