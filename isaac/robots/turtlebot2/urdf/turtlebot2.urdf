<?xml version="1.0"?>
<!--
  TurtleBot 2 (Kobuki) for Isaac Sim.

  Flattened from:
    - yujinrobot/kobuki (melodic) kobuki_description
    - turtlebot/turtlebot (melodic) hexagon stack heights
  Kinect/Xtion replaced with a Livox Mid-360 mount (link livox_frame).

  Wheel radius 0.035 m, wheel separation 0.230 m.
  Casters are low-friction spheres (fixed) so PhysX does not jam the base.
-->
<robot name="turtlebot2">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="aluminium">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.42 0.04 1.0"/>
  </material>

  <!-- Tiny mass so the URDF converter treats this as a rigid body, not world. -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
               iyy="1e-6" iyz="0.0"
               izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.0102" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.001 0 0.05199" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/kobuki/main_body.dae"/>
      </geometry>
    </visual>
    <collision name="base">
      <origin xyz="0.0 0 0.05949" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.10938" radius="0.178"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.01 0 0"/>
      <mass value="2.4"/>
      <inertia ixx="0.019995" ixy="0.0" ixz="0.0"
               iyy="0.019995" iyz="0.0"
               izz="0.03675"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.00 0.115 0.0250" rpy="-1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="20"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/kobuki/wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0206" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0"
               izz="0.00006"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.00 -0.115 0.0250" rpy="-1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="20"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/kobuki/wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0206" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0"
               izz="0.00006"/>
    </inertial>
  </link>

  <!-- Fixed spherical casters: same ground contact as the wheels, low friction is applied in Isaac. -->
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.115 0.0 0.005" rpy="0 0 0"/>
  </joint>
  <link name="caster_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear_link"/>
    <origin xyz="-0.135 0.0 0.005" rpy="0 0 0"/>
  </joint>
  <link name="caster_rear_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0"
               izz="0.000001"/>
    </inertial>
  </link>

  <!-- TurtleBot 2 hexagon-stack plate heights, simplified as cylinders. -->
  <joint name="plate_bottom_joint" type="fixed">
    <origin xyz="0.0 0.0 0.1306" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="plate_bottom_link"/>
  </joint>
  <link name="plate_bottom_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.170"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Spacers down to the Kobuki body. Standoffs are visual-only: they are
         part of the same rigid link, so no extra bodies or collision shapes. -->
    <visual>
      <origin xyz="0.1256 0.0725 -0.0095" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.013" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.0 0.145 -0.0095" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.013" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.1256 0.0725 -0.0095" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.013" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.1256 -0.0725 -0.0095" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.013" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.0 -0.145 -0.0095" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.013" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.1256 -0.0725 -0.0095" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.013" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.170"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.52"/>
      <inertia ixx="0.003328" ixy="0.0" ixz="0.0"
               iyy="0.003328" iyz="0.0"
               izz="0.006656"/>
    </inertial>
  </link>

  <joint name="plate_middle_joint" type="fixed">
    <origin xyz="0.0 0.0 0.1874" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="plate_middle_link"/>
  </joint>
  <link name="plate_middle_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.170"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Standoffs down to the bottom plate. -->
    <visual>
      <origin xyz="0.1256 0.0725 -0.0284" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0508" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.0 0.145 -0.0284" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0508" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.1256 0.0725 -0.0284" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0508" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.1256 -0.0725 -0.0284" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0508" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.0 -0.145 -0.0284" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0508" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.1256 -0.0725 -0.0284" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0508" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.170"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.52"/>
      <inertia ixx="0.003328" ixy="0.0" ixz="0.0"
               iyy="0.003328" iyz="0.0"
               izz="0.006656"/>
    </inertial>
  </link>

  <joint name="plate_top_joint" type="fixed">
    <origin xyz="0.0 0.0 0.3966" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="plate_top_link"/>
  </joint>
  <link name="plate_top_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.170"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Long standoffs down to the middle plate; the lidar hangs between them. -->
    <visual>
      <origin xyz="0.1256 0.0725 -0.1046" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.2032" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.0 0.145 -0.1046" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.2032" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.1256 0.0725 -0.1046" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.2032" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="-0.1256 -0.0725 -0.1046" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.2032" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.0 -0.145 -0.1046" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.2032" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.1256 -0.0725 -0.1046" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.2032" radius="0.0065"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.170"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.52"/>
      <inertia ixx="0.003328" ixy="0.0" ixz="0.0"
               iyy="0.003328" iyz="0.0"
               izz="0.006656"/>
    </inertial>
  </link>

  <!-- Inverted Livox Mid-360 under the top plate.
       From behind the robot: lidar x = right, y = back, z = down. -->
  <joint name="livox_joint" type="fixed">
    <origin xyz="0.0 0.0 -0.033" rpy="3.141592653589793 0 -1.5707963267948966"/>
    <parent link="plate_top_link"/>
    <child link="livox_frame"/>
  </joint>
  <link name="livox_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.060" radius="0.0325"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.060" radius="0.0325"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.265"/>
      <inertia ixx="0.00015" ixy="0.0" ixz="0.0"
               iyy="0.00015" iyz="0.0"
               izz="0.00014"/>
    </inertial>
  </link>
</robot>
