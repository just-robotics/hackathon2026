# HSL25 organizer container, from the provided kobuki/docker/Dockerfile.
ARG BASE_IMAGE=nickodema/kobuki:humble-22.04-100625@sha256:2034fe21fbe8aae8677191967ec9c4fc168a1337ada7bb1913a642b92f2b8619
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV LD_LIBRARY_PATH=/usr/local/lib
# Драйверы Kobuki и Livox -- первыми: этот слой зависит только от базового
# образа и drivers/src, поэтому правки зависимостей и кода стека ниже не
# пересобирают драйверы. Здесь -- только то, что нужно им.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake python3-colcon-common-extensions \
    ros-humble-ecl-core ros-humble-ecl-tools ros-humble-ecl-console ros-humble-ecl-mobile-robot \
    ros-humble-diagnostic-updater ros-humble-robot-state-publisher \
    ros-humble-joint-state-publisher ros-humble-xacro libapr1-dev \
    && rm -rf /var/lib/apt/lists/*
# Provided hardware packages, with their original licenses. SDK2 is in the base.
COPY drivers/src /workspace/src
WORKDIR /workspace
RUN source /opt/ros/humble/setup.bash && CMAKE_BUILD_PARALLEL_LEVEL=1 \
    colcon build --parallel-workers 2 --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
# Зависимости стека: меняются чаще, поэтому после драйверов.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-yaml python3-numpy ros-humble-rmw-cyclonedds-cpp \
    ros-humble-nav2-mppi-controller ros-humble-nav2-controller \
    ros-humble-nav2-map-server ros-humble-nav2-amcl ros-humble-pointcloud-to-laserscan \
    ros-humble-nav2-lifecycle-manager ros-humble-rviz2 ros-humble-pcl-ros \
    ros-humble-teleop-twist-keyboard ros-humble-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*
# FAST-LIO2 -- локализация стека (localization: fastlio в real.yaml):
# hku-mars/FAST_LIO, ветка ROS2, закреплённый коммит. Зависит от
# livox_ros_driver2 из /workspace; до кода стека, чтобы его правки не
# пересобирали FAST-LIO2.
RUN git clone -b ROS2 --recursive https://github.com/hku-mars/FAST_LIO.git /fastlio/src/FAST_LIO && \
    git -C /fastlio/src/FAST_LIO checkout a4743b095409588842a5b30ddfa27e29d2f99164 && \
    git -C /fastlio/src/FAST_LIO submodule update --init --recursive
WORKDIR /fastlio
RUN source /workspace/install/setup.bash && CMAKE_BUILD_PARALLEL_LEVEL=1 \
    colcon build --parallel-workers 2 --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
# Build the same autonomous implementation, without Gazebo/Autoware or SLAM.
COPY src/hsl_interfaces /solution/src/hsl_interfaces
COPY src/hsl_decision /solution/src/hsl_decision
COPY src/hsl_planning /solution/src/hsl_planning
COPY src/jr_perception /solution/src/jr_perception
COPY src/jr_map /solution/src/jr_map
COPY src/jr_launch /solution/src/jr_launch
COPY src/linefit_ground_segmentation_ros2 /solution/src/linefit_ground_segmentation_ros2
COPY src/hsl_nav2_control /solution/src/hsl_nav2_control
COPY src/hsl_debug_control /solution/src/hsl_debug_control
# Shared cloud/grid utilities are imported by real_observations; no simulator nodes run.
COPY src/hsl_sim_adapter /solution/src/hsl_sim_adapter
COPY src/hsl_lidar_filter /solution/src/hsl_lidar_filter
COPY src/hsl_real /solution/src/hsl_real
WORKDIR /solution
RUN source /fastlio/install/setup.bash && CMAKE_BUILD_PARALLEL_LEVEL=1 \
    colcon build --parallel-workers 2 --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
RUN echo 'source /solution/install/setup.bash' >> /root/.bashrc
# GUI apps (rviz2) need the host's live Xwayland auth cookie; /run/user/1000 is
# bind-mounted read-only from the host, and its filename suffix changes every
# GNOME session, so resolve it fresh on every shell login instead of baking in a path.
RUN printf '%s\n' \
    'export DISPLAY=:0' \
    'xauth_file=$(ls /run/user/1000/.mutter-Xwaylandauth.* 2>/dev/null | head -1)' \
    '[ -n "$xauth_file" ] && export XAUTHORITY="$xauth_file"' \
    >> /root/.bashrc
CMD ["bash"]
